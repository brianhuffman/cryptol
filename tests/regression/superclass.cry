module superclass where

zeroRing : {a} (Ring a) => a
zeroRing = zero

zeroLogic : {a} (Logic a) => a
zeroLogic = zero

zeroIntegral : {a} (Integral a) => a
zeroIntegral = zero

fromIntIntegral : {a} (Integral a) => a
fromIntIntegral = fromInteger(42)

eqCmp : {a} (Cmp a) => a -> a -> Bit
eqCmp x y = x == y
