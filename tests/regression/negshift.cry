negLeftShift : {n} [n] -> Integer -> Bit
negLeftShift(xs, i) = xs << i == xs >> negate(i)

negRightShift : {n} [n] -> Integer -> Bit
negRightShift(xs, i) = xs >> i == xs << negate(i)

negLeftRotate : {n} [n] -> Integer -> Bit
negLeftRotate(xs, i) = xs <<< i == xs >>> negate(i)

negRightRotate : {n} [n] -> Integer -> Bit
negRightRotate(xs, i) = xs >>> i == xs <<< negate(i)

negSshr : {n} (n >= 1) => [n] -> Integer -> Bit
negSshr(xs, i) = i < 0 ==> xs >>$ i == xs << negate(i)

property nls1 = negLeftShift{8}
property nls2 = negLeftShift{32}

property nrs1 = negRightShift{8}
property nrs2 = negRightShift{32}

property nlr1 = negLeftRotate{8}
property nlr2 = negLeftRotate{32}

property nrr1 = negRightRotate{8}
property nrr2 = negRightRotate{32}

property nsshr1 = negSshr{8}
property nsshr2 = negSshr{32}
