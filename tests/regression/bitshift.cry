shift : {d} (d >=1) => [d] -> Bit -> [d]
shift(fill, bit) = fills
	where
          fills = drop{1}(fill) # [bit]

shift_alt : {d} (d >=1) => [d] -> Bit -> [d]
shift_alt(fill, bit) = fills
	where
	  fills = take{d-1}(fill >> 1) # [bit]

property shift_eq(a, b, c, d, e) = shift(take{10}(zero{[6]} # [a,b,c,d]), e)
                           == shift_alt(take{10}(zero{[6]} # [a,b,c,d]), e)
